# ------------------------------------------------------------------------------
# RedAgos Client — environment template
#
# Copy this file to `.env` and adjust the values for your machine:
#   cp .env.example .env          (PowerShell: copy .env.example .env)
#
# `.env` is gitignored. This file is committed, so it must never contain real
# credentials — placeholders only.
#
# Restart the dev server after changing any value; runtimeConfig is read at
# startup, not per-request.
# ------------------------------------------------------------------------------

# Base URL of the RedAgos backend API (the RedAgos_server Laravel app).
# Read at build/dev time by nuxt.config.ts and exposed to the browser as
# runtimeConfig.public.apiBaseURL. Include the /api suffix, no trailing slash.
#
# WARNING: this is PUBLIC runtime config and is readable in the browser.
# Never put tokens, keys, or other secrets in it.
API_BASE_URL=http://127.0.0.1:8000/api


# ------------------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------------------

# Production runtime override for the same setting.
#
# API_BASE_URL above is baked in when the app is built, so changing it on a
# built app does nothing without a rebuild. Nitro reads this NUXT_-prefixed
# variable at server startup instead, which lets one build be pointed at
# different environments. Set this in deployment, not locally.
# NUXT_PUBLIC_API_BASE_URL=https://api.example.com/api

# Port for the dev server and production preview. Defaults to 3000.
# PORT=3000
