# ------------------------------------------------------------------------------
# RedAgos Client — environment template
#
# Copy this file to `.env` and adjust the values for your machine:
#   cp .env.example .env          (PowerShell: copy .env.example .env)
#
# `.env` is gitignored. This file is committed, so it must never contain real
# credentials — placeholders only.
#
# For local development every value below is OPTIONAL — an empty `.env` is the
# correct, working default. If you do set one, restart the dev server:
# runtimeConfig is read at startup, not per-request.
# ------------------------------------------------------------------------------

# Base URL of the RedAgos backend API (the RedAgos_server Laravel app).
#
# LEAVE THIS UNSET for local development. When empty, BaseService derives the
# API host from the browser's own location — a page served from
# http://192.168.0.104:3000 calls http://192.168.0.104:8000/api. That is what
# makes cross-device testing (phone on the same Wi-Fi) work without editing
# this file every time the LAN IP changes.
#
# Setting it to 127.0.0.1 works on your own machine and silently breaks on a
# phone, where 127.0.0.1 means the phone itself.
#
# Set it only when the derived value would be wrong:
#   - Laravel running on a port other than 8000
#   - API on a different host than the one serving the client
#   - a local client pointed at a shared staging API
#   - a tunnel (ngrok / Cloudflare) where page and API origins differ
# Include the /api suffix, no trailing slash.
#
# WARNING: this is PUBLIC runtime config and is readable in the browser.
# Never put tokens, keys, or other secrets in it.
# API_BASE_URL=http://127.0.0.1:8000/api


# ------------------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------------------

# Production runtime override for the same setting.
#
# API_BASE_URL above is baked in when the app is built, so changing it on a
# built app does nothing without a rebuild. Nitro reads this NUXT_-prefixed
# variable at server startup instead, which lets one build be pointed at
# different environments. Set this in deployment, not locally.
#
# Effectively REQUIRED in production: the browser-derive fallback assumes the
# API is on port 8000 of the same host, which is rarely true once deployed.
# NUXT_PUBLIC_API_BASE_URL=https://api.example.com/api

# Port for the dev server and production preview. Defaults to 3000.
# PORT=3000

# Note: `npm run dev` binds all network interfaces (`nuxt dev --host` in
# package.json) so other devices on the same Wi-Fi can reach it. Nuxt prints
# the reachable Network URL on startup — use that, not localhost, when
# testing the LAN path.
